# AI 비서 "민지" 환경설정
# 이 파일을 .env로 복사하고 필요한 값을 입력하세요.

PORT=3000
NODE_ENV=development

# 선택사항: 서버에서 기본 Claude API 키 설정
# (클라이언트 사이드에서 입력하는 것을 권장)
CLAUDE_API_KEY=sk-...

# 업무관리(R&R) 설정 (선택)
# RR_DATA_DIR=data          # 데이터·첨부파일 저장 폴더
# RR_TZ=Asia/Seoul          # '오늘' 기준 시간대
# RR_MAX_FILE_MB=20         # 첨부파일 1개 최대 크기(MB)
